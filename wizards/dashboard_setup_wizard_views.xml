<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_merka_dashboard_setup_wizard_form" model="ir.ui.view">
        <field name="name">merka.dashboard.setup.wizard.form</field>
        <field name="model">merka.dashboard.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Assistant Dashboard Merka">
                <group>
                    <field name="name"/>
                    <field name="pack_code"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_create_dashboard" type="object" string="Créer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_merka_dashboard_setup_wizard" model="ir.actions.act_window">
        <field name="name">Assistant de création</field>
        <field name="res_model">merka.dashboard.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
