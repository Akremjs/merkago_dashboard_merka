<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions serveur : un dashboard par module métier -->
    <record id="action_open_pack_sales" model="ir.actions.server">
        <field name="name">Dashboard Ventes</field>
        <field name="model_id" ref="model_merka_dashboard"/>
        <field name="state">code</field>
        <field name="binding_model_id" eval="False"/>
        <field name="code">
action = env['merka.dashboard'].with_context(merka_pack_code='sales').action_open_pack_dashboard()
        </field>
    </record>

