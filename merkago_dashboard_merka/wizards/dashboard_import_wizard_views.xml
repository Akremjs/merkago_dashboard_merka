<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_merka_dashboard_import_wizard_form" model="ir.ui.view">
        <field name="name">merka.dashboard.import.wizard.form</field>
        <field name="model">merka.dashboard.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer un tableau de bord">
                <group>
                    <field name="data_filename" invisible="1"/>
                    <field name="data_file" filename="data_filename"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importer" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_merka_dashboard_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer</field>
        <field name="res_model">merka.dashboard.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

