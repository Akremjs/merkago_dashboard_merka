<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_merka_dashboard" model="ir.module.category">
        <field name="name">Dashboard Merka</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_merka_dashboard_restricted" model="res.groups">
        <field name="name">Restricted</field>
        <field name="category_id" ref="module_category_merka_dashboard"/>
        <field name="comment">Voit uniquement les tableaux explicitement assignés (utilisateurs ou groupes).</field>
    </record>

    <record id="group_merka_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_merka_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_merka_dashboard_restricted'))]"/>
        <field name="comment">Voit les tableaux publics (sans restriction) et ceux auxquels il a accès.</field>
    </record>

    <record id="group_merka_dashboard_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_merka_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_merka_dashboard_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Accès complet : création, droits, configuration.</field>
    </record>

    <!-- Tous les utilisateurs internes peuvent lire les dashboards -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_merka_dashboard_user'))]"/>
    </record>
    <!-- Les admins Settings ont le droit Administrator Merka -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_merka_dashboard_manager'))]"/>
    </record>

    <!-- Multi-company (tous) -->
    <record id="merka_dashboard_company_rule" model="ir.rule">
        <field name="name">Dashboard Merka: multi-company</field>
        <field name="model_id" ref="model_merka_dashboard"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Restricted seul : uniquement assignations explicites -->
    <record id="merka_dashboard_restricted_rule" model="ir.rule">
        <field name="name">Dashboard Merka: restricted only assigned</field>
        <field name="model_id" ref="model_merka_dashboard"/>
        <field name="groups" eval="[(4, ref('group_merka_dashboard_restricted'))]"/>
        <field name="domain_force">['|', ('user_ids', 'in', [user.id]), ('group_ids', 'in', user.groups_id.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- User : tableaux sans restriction OU assignés -->
    <record id="merka_dashboard_user_rule" model="ir.rule">
        <field name="name">Dashboard Merka: user public or assigned</field>
        <field name="model_id" ref="model_merka_dashboard"/>
        <field name="groups" eval="[(4, ref('group_merka_dashboard_user'))]"/>
        <field name="domain_force">['|', '|',
            ('group_ids', '=', False),
            ('group_ids', 'in', user.groups_id.ids),
            ('user_ids', 'in', [user.id])]</field>
    </record>

    <!-- Manager : tout -->
    <record id="merka_dashboard_manager_rule" model="ir.rule">
        <field name="name">Dashboard Merka: manager all</field>
        <field name="model_id" ref="model_merka_dashboard"/>
        <field name="groups" eval="[(4, ref('group_merka_dashboard_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="merka_dashboard_item_company_rule" model="ir.rule">
        <field name="name">Dashboard Item Merka: multi-company</field>
        <field name="model_id" ref="model_merka_dashboard_item"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
